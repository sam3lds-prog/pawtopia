# Copy to .env.local (git-ignored) and fill in what you have. Empty = that service stays off.
# See docs/native-setup.md.

# RevenueCat public iOS SDK key (starts with appl_). Enables gem packs on the iOS app.
VITE_REVENUECAT_IOS_KEY=

# AdMob: set ENABLED=1 only after Info.plist has GADApplicationIdentifier, SKAdNetworkItems and
# NSUserTrackingUsageDescription. Leave REWARDED_IOS empty to use Google's test videos.
VITE_ADMOB_ENABLED=
VITE_ADMOB_REWARDED_IOS=

# Firebase Web app config (leaderboards).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=us-central1
# Point a development build at local Firebase emulators.
VITE_FIREBASE_EMULATORS=
