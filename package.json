{
  "name": "pawtopia",
  "version": "0.2.0",
  "private": true,
  "description": "Pawtopia — a cozy logic puzzle. One cat and one dog in every row, column and region; a sanctuary that grows as you solve.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "gen:check": "tsx scripts/verify-generator.ts",
    "grade:report": "tsx scripts/grade-report.ts",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "pack:build": "tsx scripts/build-level-pack.ts --write && tsx scripts/build-journey-pack.ts --write",
    "pack:check": "tsx scripts/build-level-pack.ts && tsx scripts/build-journey-pack.ts",
    "e2e": "node test/e2e/smoke.mjs",
    "artifact": "node scripts/make-artifact.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.7.3"
  }
}
